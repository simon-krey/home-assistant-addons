# --- Audio ---
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_BLOCK_MS=100
# AUDIO_DEVICE=Nor-Tec streaming mic

# --- STT ---
# STT_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-de-kroko-2025-08-06
STT_NUM_THREADS=2
STT_PROVIDER=cpu
STT_ENABLE_ENDPOINT=true
STT_RULE1_TRAILING_SILENCE=2.4
STT_RULE2_TRAILING_SILENCE=1.0

# --- Needle ---
NEEDLE_MAX_NEW_TOKENS=256
NEEDLE_CONFIDENCE_THRESHOLD=0.7
# NEEDLE_SYSTEM=

# --- Home Assistant ---
HA_USE_MOCK=true
HA_DRY_RUN=true
HA_URL=
HA_TOKEN=
HA_RECONNECT=true
HA_RECONNECT_DELAY=3.0

# --- Web UI ---
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
